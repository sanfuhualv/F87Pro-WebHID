  "identifier": "full-local-driver",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-snapshot",
    "allow-play-share",
    "allow-download-share",
    "allow-play-public",
    "allow-play-sequence",
    "allow-play-cached",
    "allow-list-cached",
    "allow-stop-playback",
    "allow-hide-window",
    "allow-hid-begin",
    "allow-hid-send",
    "allow-hid-end",
    "allow-hid-poll",
    "allow-hid-detach",
    "allow-open-driver",
